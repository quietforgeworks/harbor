-	if err != nil {
-		return nil, err
-	}
-	address := net.JoinHostPort(ip.String(), fmt.Sprintf("%d", metadata.DstPort))
-	conn, err := instance.Dial(ctx, "tcp4", address)
-	if err != nil {
-		return nil, err
-	}
-	if conn == nil {
-		return nil, errors.New("conn is nil")
