-func (e *EasyTier) Close() error {
-	e.cancel()
-	if e.unregister != nil {
-		e.unregister()
-	}
-	e.startMu.Lock()
-	e.closed = true
-	if e.readyCh != nil {
-		close(e.readyCh)
-		e.readyCh = nil
-	}
-	e.startMu.Unlock()
-	return e.shutdown()
-}
