-func (e *EasyTier) shutdown() error {
-	ctx, cancel := context.WithTimeout(context.Background(), C.DefaultTCPTimeout)
-	defer cancel()
-	e.mu.Lock()
-	instance := e.instance
-	host := e.host
-	e.instance = nil
-	e.host = nil
-	e.mu.Unlock()
-	var err error
-	if instance != nil {
-		err = instance.Close(ctx)
-	}
-	if host != nil {
-		if hostErr := host.Close(ctx); err == nil {
-			err = hostErr
-		}
-	}
-	return err
-}
